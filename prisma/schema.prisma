// Celestial — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ImportedEvent {
  id          String   @id @default(cuid())
  iso         String // gregorian yyyy-mm-dd
  jalaliIso   String // jalali yyyy-mm-dd (canonical secondary)
  title       String
  description String?
  isHoliday   Boolean  @default(false)
  sourceName  String   @default("import") // originating file name
  createdAt   DateTime @default(now())

  @@index([iso])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
