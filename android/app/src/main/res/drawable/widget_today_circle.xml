<?xml version="1.0" encoding="utf-8"?>
<!-- Celestial — today highlight circle for month widget cells:
     #C2185B magenta gradient with a soft white hairline (round 15) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#E91E63"
        android:endColor="#C2185B" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
