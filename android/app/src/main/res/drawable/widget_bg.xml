<?xml version="1.0" encoding="utf-8"?>
<!-- Celestial — widget card background (round 15): deep translucent charcoal
     vertical gradient with a soft magenta hairline; 24dp corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#F01E171C"
        android:endColor="#E6251922" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#66C2185B" />
</shape>
